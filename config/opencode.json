{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "YOUR_API_KEY_HERE"
        }
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest", "--config", "__HOME__/.config/opencode/playwright-mcp-brave.json"]
      },
      "ai-memory": {
        "type": "remote",
        "url": "http://127.0.0.1:49374/mcp",
        "oauth": false
      }
    }
  },
  "providers": {
    "openrouter": {
      "name": "OpenRouter",
      "models": {
        "nvidia/nemotron-3.5-super-vl:free": {
          "name": "Nemotron Super VL (free)"
        }
      }
    },
    "ollama": {
      "name": "Ollama Local",
      "settings": {
        "baseURL": "YOUR_OLLAMA_BASE_URL",
        "apiKey": "YOUR_API_KEY_HERE"
      },
      "models": {
        "qwen3.8:latest": {
          "name": "Qwen 3.8"
        },
        "glm-5.3-flash:cloud": {
          "name": "GLM-5.3"
        }
      }
    }
  }
}